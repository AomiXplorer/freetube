# ---------------------------------------------------------------------------
# Freetube environment variables
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata / PWA manifest start_url)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Region/language hints for InnerTube (ISO-3166 alpha-2 / BCP-47)
INNERTUBE_REGION=US
INNERTUBE_LANGUAGE=en

# Optional Redis cache (Upstash REST or Vercel KV). If absent, the app falls
# back to an in-memory LRU cache (fine for local dev, resets on cold start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 32+ char random string. Encrypts the YouTube session cookies users paste in
# Settings before they are stored in an httpOnly cookie.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional: base64 visitorData from a browser session. Helps when the
# datacenter IP gets the "Sign in to confirm you're not a bot" wall.
YT_VISITOR_DATA=

# Optional: override the public InnerTube keys (only needed if YouTube rotates them).
# Find current values in any youtube.com DevTools request to /youtubei/v1/.
# YT_KEY_WEB=
# YT_KEY_ANDROID=
# YT_KEY_IOS=

# ---------------------------------------------------------------------------
# Google TV OAuth (device flow sign-in)
# The defaults are the long-public YouTube TV (Cobalt) client identifiers that
# open-source TV clients ship with. They are NOT your credentials and grant
# nothing on their own: a token only exists after a user approves this device
# code on google.com/device with their own account. Override only if Google
# rotates them.
# ---------------------------------------------------------------------------
# YT_OAUTH_CLIENT_ID=861556708454-d6dlm3lh05idd8npek18k6be8ba3oc68.apps.googleusercontent.com
# YT_OAUTH_CLIENT_SECRET=
